  "content": [
    {
      "dest": "zim/ (Wikimedia: Wikipedia EN full, medicine, simple; Wikibooks, Wikiversity, Wikisource, Wikivoyage, Wiktionary; Spanish Wikipedia top and medicine, Wikibooks ES, Vikidia ES)",
      "fetch": [
        "fetch/download_zims.sh",
        "fetch/download_zims_es.sh",
        "fetch/download_maps_datasets.sh (queue_zims)"
      ],
      "license": "CC BY-SA 4.0 (text; media carry their own licenses)",
      "status": "scripted",
      "note": "File names carry a date. When download.kiwix.org drops one, take the newest file in the same folder."
    },
    {
      "dest": "zim/ (Stack Exchange: DIY, Electronics, Ham Radio, Gardening, Outdoors, Medical Sciences, Physics, Chemistry)",
      "fetch": [
        "fetch/download_maps_datasets.sh (queue_zims)"
      ],
      "license": "CC BY-SA 4.0",
      "status": "scripted"
    },
    {
      "dest": "zim/gutenberg_en_all_2025-11.zim",
      "size_gb": 206,
      "fetch": [
        "fetch/download_zims.sh"
      ],
      "license": "Public domain in the US; Project Gutenberg trademark terms (library/LICENSES.md)",
      "status": "scripted"
    },
    {
      "dest": "zim/ (Appropedia, Energypedia, PhET)",
      "fetch": [
        "fetch/download_zims.sh",
        "fetch/download_maps_datasets.sh"
      ],
      "license": "CC BY-SA 4.0 (Appropedia, Energypedia: verify), CC BY 4.0 (PhET)",
      "status": "scripted"
    },
    {
      "dest": "zim/ifixit_en_all_2025-12.zim",
      "fetch": [
        "fetch/download_zims.sh"
      ],
      "license": "CC BY-NC-SA 3.0 (noncommercial)",
      "status": "scripted"
    },
    {
      "dest": "zim/ (zimgit post-disaster, knots, medicine, water, food preparation)",
      "fetch": [
        "fetch/download_zims.sh"
      ],
      "license": "Collections of published documents, mixed licenses (verify per document)",
      "status": "scripted"
    },
    {
      "dest": "zim/trueprepper.com_en_all_2026-05.zim",
      "size_gb": 1.3,
      "fetch": [
        "fetch/download_zims.sh"
      ],
      "license": "Website copyright of its owner; ZIM published by Kiwix (verify before giving or selling a box)",
      "status": "scripted"
    },
    {
      "dest": "zim/medlineplus.gov_es_all_2024-12.zim",
      "fetch": [
        "fetch/download_zims_es.sh"
      ],
      "license": "US government, mostly public domain; some licensed parts (verify)",
      "status": "scripted"
    },
    {
      "dest": "zim/ted_mul_*_2026-04.zim (biology, chemistry, health care, medicine, physics)",
      "fetch": [
        "fetch/download_tier3.sh"
      ],
      "license": "CC BY-NC-ND 4.0 (noncommercial, no derivatives)",
      "status": "scripted"
    },
    {
      "dest": "zim/batteryuniversity_en_2026-09.zim",
      "size_gb": 0.02,
      "fetch": [],
      "license": "Copyrighted site",
      "status": "dropped",
      "note": "A private crawl of a copyrighted website. Public builds leave it out."
    },
    {
      "dest": "maps/osmand, maps/organicmaps, maps/geofabrik, maps/pmtiles (planet basemap)",
      "size_gb": 305,
      "fetch": [
        "fetch/download_maps_datasets.sh",
        "fetch/download_organicmaps.sh",
        "fetch/download_planet_pmtiles.sh"
      ],
      "license": "ODbL 1.0, © OpenStreetMap contributors (keep the attribution); Protomaps build tools BSD-3-Clause",
      "status": "scripted",
      "note": "The OsmAnd file list comes from OsmAnd's live index. The US pmtiles extract needs the pmtiles command-line tool (brew install pmtiles)."
    },
    {
      "dest": "maps/noaa_charts",
      "fetch": [
        "fetch/download_noaa_charts.sh"
      ],
      "license": "US government, public domain",
      "status": "scripted"
    },
    {
      "dest": "maps/topo_ca",
      "fetch": [
        "fetch/download_topo_ca.py"
      ],
      "license": "USGS, public domain",
      "status": "scripted"
    },
    {
      "dest": "maps/satellite_ca (and the Bay Area MBTiles)",
      "fetch": [
        "fetch/download_satellite_ca.py",
        "fetch/download_satellite.sh"
      ],
      "license": "USGS USGSImageryOnly (NAIP), public domain",
      "status": "scripted"
    },
    {
      "dest": "datasets/climate_normals, datasets/ephemeris, datasets/fcc, datasets/dailymed",
      "size_gb": 20.6,
      "fetch": [
        "fetch/download_maps_datasets.sh"
      ],
      "license": "NOAA NCEI, JPL DE440s, FCC ULS, NLM DailyMed: US government, public domain",
      "status": "scripted",
      "note": "DailyMed is kept out of search and out of the title list on purpose, because the library's own pages never give drug doses."
    },
    {
      "dest": "docs/cd3wd",
      "size_gb": 141,
