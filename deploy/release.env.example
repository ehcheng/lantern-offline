# The stamped release that new boxes are built from (copy to deploy/release.env; that copy stays out of git).
# deploy/new_box.sh reads it. Fill it in after building an image and sealing a library.
RELEASE=lantern-YYYY.MM.DD             # git tag the image and library were built from
IMAGE=lantern-boot-X.Y.Z+gCOMMIT.img   # file name in image/deploy/
IMAGE_SHA256=                          # shasum -a 256 image/deploy/$IMAGE
LIBRARY=YYYY.MM.DD                     # library/VERSION.json "library"
LIBRARY_MANIFEST=                      # shasum -a 256 library/MANIFEST.sha256
# where the image file is looked for, first hit wins (override with IMG=/path/to/file.img)
IMAGE_DIRS="image/deploy"
